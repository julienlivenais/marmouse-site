---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Marmouse — La maison a sa mémoire. Privée."
  description="Application familiale locale, chiffrée, sans cloud. Calendrier, missions, courses, mode tablette murale. Vos données restent chez vous."
>
  <!-- Hero -->
  <section class="relative overflow-hidden py-24 sm:py-36 bg-gradient-to-b from-violet-50 to-white">
    <!-- Background gradient orbs — subtils sur fond clair -->
    <div class="absolute inset-0 -z-10 pointer-events-none">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[500px] rounded-full bg-violet-200/40 blur-3xl"></div>
      <div class="absolute bottom-0 right-0 w-[400px] h-[300px] rounded-full bg-indigo-200/30 blur-3xl"></div>
    </div>

    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 text-center">
      <!-- Badges -->
      <div class="flex flex-wrap justify-center gap-2 mb-8">
        <div class="inline-flex items-center gap-2 rounded-full border border-amber-300 bg-amber-50 px-4 py-1.5 text-xs font-medium text-amber-700">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
          Bêta fermée &mdash; accès sur invitation
        </div>
        <div class="inline-flex items-center gap-2 rounded-full border border-violet-300 bg-violet-50 px-4 py-1.5 text-xs font-medium text-violet-700">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-violet-500"></span>
          Local-first &bull; Chiffrement E2E &bull; RGPD by design
        </div>
      </div>

      <!-- Headline -->
      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-slate-900 mb-6 leading-tight">
        La maison a sa mémoire.<br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-600 to-indigo-500">Privée.</span>
      </h1>

      <!-- Subtitle -->
      <p class="mx-auto max-w-2xl text-lg sm:text-xl text-slate-600 mb-10 leading-relaxed">
        Application familiale locale, chiffrée, sans cloud.
        Vos données ne quittent jamais votre maison &mdash; même nous ne pouvons pas les lire.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="https://app.marmouse.fr"
          class="w-full sm:w-auto rounded-xl bg-violet-600 px-8 py-4 text-base font-semibold text-white shadow-xl shadow-violet-300/50 hover:bg-violet-500 transition-all hover:-translate-y-0.5"
        >
          Rejoindre la bêta
        </a>
        <a
          href="/fonctionnalites"
          class="w-full sm:w-auto rounded-xl border border-slate-300 bg-white px-8 py-4 text-base font-semibold text-slate-700 hover:bg-slate-50 hover:border-slate-400 transition-colors"
        >
          Voir les fonctionnalités
        </a>
      </div>

      <!-- Trust signals -->
      <p class="mt-8 text-sm text-slate-400">
        Bêta fermée &bull; Accès sur invitation &bull; Sans carte bancaire
      </p>
    </div>
  </section>

  <!-- Features grid -->
  <section class="py-20 sm:py-28 bg-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Tout ce dont une famille a besoin</h2>
        <p class="text-slate-500 text-lg max-w-xl mx-auto">Une seule application, toutes les générations.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Calendrier -->
        <div class="group rounded-2xl border border-slate-200 bg-white p-6 hover:border-violet-300 hover:shadow-lg hover:shadow-violet-100 transition-all">
          <div class="mb-4 w-12 h-12 rounded-xl bg-violet-100 flex items-center justify-center text-2xl group-hover:bg-violet-200 transition-colors">
            📅
          </div>
          <h3 class="font-semibold text-slate-900 mb-2">Calendrier familial</h3>
          <p class="text-sm text-slate-500 leading-relaxed">
            Synchronisation Google Calendar et Microsoft, événements partagés, vue par membre.
          </p>
        </div>

        <!-- Missions -->
        <div class="group rounded-2xl border border-slate-200 bg-white p-6 hover:border-indigo-300 hover:shadow-lg hover:shadow-indigo-100 transition-all">
          <div class="mb-4 w-12 h-12 rounded-xl bg-indigo-100 flex items-center justify-center text-2xl group-hover:bg-indigo-200 transition-colors">
            ✅
          </div>
          <h3 class="font-semibold text-slate-900 mb-2">Missions gamifiées</h3>
          <p class="text-sm text-slate-500 leading-relaxed">
            Missions, points, streaks et récompenses. Motiver les enfants sans les braquer.
          </p>
        </div>

        <!-- Courses -->
        <div class="group rounded-2xl border border-slate-200 bg-white p-6 hover:border-violet-300 hover:shadow-lg hover:shadow-violet-100 transition-all">
          <div class="mb-4 w-12 h-12 rounded-xl bg-violet-100 flex items-center justify-center text-2xl group-hover:bg-violet-200 transition-colors">
            🛒
          </div>
          <h3 class="font-semibold text-slate-900 mb-2">Liste de courses</h3>
          <p class="text-sm text-slate-500 leading-relaxed">
            Multi-magasin, collaborative, avec scanner OCR de ticket de caisse intégré.
          </p>
        </div>

        <!-- Mur -->
        <div class="group rounded-2xl border border-slate-200 bg-white p-6 hover:border-indigo-300 hover:shadow-lg hover:shadow-indigo-100 transition-all">
          <div class="mb-4 w-12 h-12 rounded-xl bg-indigo-100 flex items-center justify-center text-2xl group-hover:bg-indigo-200 transition-colors">
            🖥️
          </div>
          <h3 class="font-semibold text-slate-900 mb-2">Mode tablette murale</h3>
          <p class="text-sm text-slate-500 leading-relaxed">
            5 thèmes, horloge, lisible à 1 mètre. Votre hub familial affiché en permanence.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why local-first -->
  <section class="py-20 sm:py-28 bg-slate-50 border-t border-slate-100">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <!-- Text -->
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-violet-200 bg-violet-50 px-3 py-1 text-xs font-medium text-violet-700 mb-6">
            Pourquoi local-first ?
          </div>
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-6 leading-tight">
            Vos données familiales sont les plus sensibles qui soient
          </h2>
          <p class="text-slate-600 text-lg mb-8 leading-relaxed">
            Emplois du temps, habitudes, localisations, argent de poche.
            Ces informations ne devraient jamais atterrir sur des serveurs
            tiers, être monétisées ou exposées en cas de fuite.
          </p>
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <div class="mt-1 w-5 h-5 rounded-full bg-violet-100 flex items-center justify-center flex-shrink-0">
                <div class="w-2 h-2 rounded-full bg-violet-600"></div>
              </div>
              <p class="text-slate-600 text-sm leading-relaxed">
                <span class="font-semibold text-slate-900">Stockage local</span> &mdash; vos données restent sur vos appareils, synchronisées en P2P chiffré.
              </p>
            </div>
            <div class="flex items-start gap-3">
              <div class="mt-1 w-5 h-5 rounded-full bg-violet-100 flex items-center justify-center flex-shrink-0">
                <div class="w-2 h-2 rounded-full bg-violet-600"></div>
              </div>
              <p class="text-slate-600 text-sm leading-relaxed">
                <span class="font-semibold text-slate-900">Chiffrement E2E</span> &mdash; même si quelqu'un intercepte les données, elles sont illisibles sans votre clé.
              </p>
            </div>
            <div class="flex items-start gap-3">
              <div class="mt-1 w-5 h-5 rounded-full bg-violet-100 flex items-center justify-center flex-shrink-0">
                <div class="w-2 h-2 rounded-full bg-violet-600"></div>
              </div>
              <p class="text-slate-600 text-sm leading-relaxed">
                <span class="font-semibold text-slate-900">Zéro tracking</span> &mdash; aucune analytics, aucune pub, aucune vente de profil.
              </p>
            </div>
          </div>
          <div class="mt-8">
            <a href="/philosophie" class="inline-flex items-center gap-2 text-violet-600 font-medium hover:text-violet-500 transition-colors text-sm">
              Lire notre philosophie
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Stats / Visual -->
        <div class="grid grid-cols-2 gap-4">
          <div class="rounded-2xl border border-violet-200 bg-white p-6 text-center shadow-sm">
            <div class="text-4xl font-extrabold text-violet-600 mb-2">E2E</div>
            <div class="text-sm text-slate-500">Chiffrement<br />bout à bout</div>
          </div>
          <div class="rounded-2xl border border-indigo-200 bg-white p-6 text-center shadow-sm">
            <div class="text-4xl font-extrabold text-indigo-600 mb-2">0</div>
            <div class="text-sm text-slate-500">Tracking,<br />zéro pub</div>
          </div>
          <div class="rounded-2xl border border-violet-200 bg-white p-6 text-center shadow-sm">
            <div class="text-4xl font-extrabold text-violet-600 mb-2">P2P</div>
            <div class="text-sm text-slate-500">Sync directe<br />sans serveur</div>
          </div>
          <div class="rounded-2xl border border-indigo-200 bg-white p-6 text-center shadow-sm">
            <div class="text-4xl font-extrabold text-indigo-600 mb-2">RGPD</div>
            <div class="text-sm text-slate-500">By design,<br />pas en option</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Profiles -->
  <section class="py-20 sm:py-28 bg-white border-t border-slate-100">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Une interface par génération</h2>
        <p class="text-slate-500 text-lg max-w-xl mx-auto">
          Chaque membre de la famille voit ce qui lui correspond, avec une expérience adaptée à son âge.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Parent -->
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-8">
          <div class="text-3xl mb-4">👨‍👩‍👧</div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Parent</h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Dashboard complet, contrôles parentaux, vue d'ensemble de la famille.
            Gestion des tâches, approbation des récompenses, configuration.
          </p>
          <ul class="space-y-1 text-xs text-slate-400">
            <li>+ Gestion complète</li>
            <li>+ Contrôle parental</li>
            <li>+ Statistiques famille</li>
          </ul>
        </div>

        <!-- Ado -->
        <div class="rounded-2xl border border-violet-200 bg-gradient-to-b from-violet-50 to-white p-8 shadow-sm">
          <div class="text-3xl mb-4">🧑‍💻</div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Ado</h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Interface gamifiée, gradient violet. Points, missions, classement.
            Autonomie progressive avec visibilité sur son score.
          </p>
          <ul class="space-y-1 text-xs text-violet-500">
            <li>+ Missions &amp; points</li>
            <li>+ Streaks</li>
            <li>+ Récompenses</li>
          </ul>
        </div>

        <!-- Enfant -->
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-8">
          <div class="text-3xl mb-4">🧒</div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Enfant (6-10 ans)</h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Interface simplifiée, gros éléments, couleurs vives. Missions présentées
            comme des aventures. Validées par les parents.
          </p>
          <ul class="space-y-1 text-xs text-slate-400">
            <li>+ Missions simples</li>
            <li>+ Validation parentale</li>
            <li>+ Étoiles &amp; badges</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Final -->
  <section class="py-20 sm:py-28 bg-gradient-to-b from-violet-50 to-white border-t border-violet-100">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-amber-300 bg-amber-50 px-4 py-1.5 text-xs font-medium text-amber-700 mb-6">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
        Bêta fermée en cours
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-6">
        Rejoignez les premières familles Marmouse
      </h2>
      <p class="text-slate-600 text-lg mb-10">
        Accès sur invitation uniquement. Vos données restent privées, chiffrées de bout en bout.
      </p>
      <a
        href="https://app.marmouse.fr"
        class="inline-block rounded-xl bg-violet-600 px-10 py-5 text-lg font-semibold text-white shadow-2xl shadow-violet-300/50 hover:bg-violet-500 transition-all hover:-translate-y-0.5"
      >
        Rejoindre la bêta
      </a>
      <p class="mt-6 text-xs text-slate-400">
        Vous avez un code d'invitation ? Rendez-vous directement sur l'app.
      </p>
    </div>
  </section>
</Layout>
