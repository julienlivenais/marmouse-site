---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact — Marmouse"
  description="Contactez l'équipe Marmouse pour toute question, suggestion ou retour."
>
  <section class="py-20 sm:py-28">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div class="inline-flex items-center gap-2 rounded-full border border-violet-800/50 bg-violet-950/50 px-4 py-1.5 text-xs font-medium text-violet-300 mb-6">
          Contact
        </div>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-white mb-6">Une question ?</h1>
        <p class="text-lg text-slate-400 leading-relaxed max-w-xl mx-auto">
          Une idée, un bug, une suggestion ou juste envie de discuter local-first ? On vous répond en moins de 48h.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

        <!-- Contact info -->
        <div class="space-y-6">
          <!-- Email -->
          <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-xl bg-violet-900/50 flex items-center justify-center text-xl flex-shrink-0">
                ✉️
              </div>
              <div>
                <h3 class="font-semibold text-white">Email</h3>
                <p class="text-xs text-slate-500">Réponse sous 48h</p>
              </div>
            </div>
            <a
              href="mailto:contact@marmouse.fr"
              class="text-violet-400 hover:text-violet-300 transition-colors font-medium"
            >
              contact@marmouse.fr
            </a>
          </div>

          <!-- Note -->
          <div class="rounded-2xl border border-slate-800/50 bg-slate-900/30 p-5">
            <p class="text-xs text-slate-500 leading-relaxed">
              Marmouse est un projet indie développé en France. Pas de service client automatisé, pas de bot.
              Vous répondra une vraie personne, rapidement.
            </p>
          </div>
        </div>

        <!-- Contact form -->
        <div class="rounded-2xl border border-slate-800 bg-slate-900 p-8">
          <h2 class="text-lg font-bold text-white mb-6">Envoyer un message</h2>
          <form action="" method="POST" class="space-y-4">
            <div>
              <label for="name" class="block text-sm font-medium text-slate-300 mb-1.5">Nom</label>
              <input
                type="text"
                id="name"
                name="name"
                autocomplete="name"
                placeholder="Votre nom"
                class="w-full rounded-xl border border-slate-700 bg-slate-800 px-4 py-3 text-sm text-white placeholder-slate-500 focus:border-violet-500 focus:outline-none focus:ring-1 focus:ring-violet-500 transition-colors"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-slate-300 mb-1.5">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                autocomplete="email"
                placeholder="vous@exemple.fr"
                class="w-full rounded-xl border border-slate-700 bg-slate-800 px-4 py-3 text-sm text-white placeholder-slate-500 focus:border-violet-500 focus:outline-none focus:ring-1 focus:ring-violet-500 transition-colors"
              />
            </div>
            <div>
              <label for="subject" class="block text-sm font-medium text-slate-300 mb-1.5">Sujet</label>
              <select
                id="subject"
                name="subject"
                class="w-full rounded-xl border border-slate-700 bg-slate-800 px-4 py-3 text-sm text-white focus:border-violet-500 focus:outline-none focus:ring-1 focus:ring-violet-500 transition-colors appearance-none"
              >
                <option value="" disabled selected>Choisir un sujet...</option>
                <option value="question">Question générale</option>
                <option value="bug">Signaler un bug</option>
                <option value="feature">Suggérer une fonctionnalité</option>
                <option value="security">Problème de sécurité</option>
                <option value="autre">Autre</option>
              </select>
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-slate-300 mb-1.5">Message</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                placeholder="Décrivez votre question ou votre retour..."
                class="w-full rounded-xl border border-slate-700 bg-slate-800 px-4 py-3 text-sm text-white placeholder-slate-500 focus:border-violet-500 focus:outline-none focus:ring-1 focus:ring-violet-500 transition-colors resize-none"
              ></textarea>
            </div>
            <button
              type="submit"
              class="w-full rounded-xl bg-violet-600 px-6 py-3.5 text-sm font-semibold text-white hover:bg-violet-500 transition-colors shadow-lg shadow-violet-900/30"
            >
              Envoyer le message
            </button>
            <p class="text-xs text-slate-600 text-center">
              En envoyant ce formulaire, vous acceptez que nous vous contactions par email uniquement pour répondre à votre demande.
            </p>
          </form>
        </div>

      </div>
    </div>
  </section>
</Layout>
